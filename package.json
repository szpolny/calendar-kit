{
  "name": "@szpolny/calendar-kit",
  "version": "0.1.0",
  "description": "Shared Svelte calendar controls and schedule utilities",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "files": [
    "dist"
  ],
  "exports": {
    "./dates": {
      "types": "./dist/dates.d.ts",
      "default": "./dist/dates.js"
    },
    "./ics": {
      "types": "./dist/ics.d.ts",
      "default": "./dist/ics.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "default": "./dist/snapshot.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    },
    "./prefs": {
      "types": "./dist/prefs.d.ts",
      "default": "./dist/prefs.js"
    },
    "./SearchPicker.svelte": {
      "types": "./dist/components/SearchPicker.svelte.d.ts",
      "svelte": "./dist/components/SearchPicker.svelte"
    },
    "./TimeZonePicker.svelte": {
      "types": "./dist/components/TimeZonePicker.svelte.d.ts",
      "svelte": "./dist/components/TimeZonePicker.svelte"
    },
    "./ThemeToggle.svelte": {
      "types": "./dist/components/ThemeToggle.svelte.d.ts",
      "svelte": "./dist/components/ThemeToggle.svelte"
    },
    "./SubscribeDialog.svelte": {
      "types": "./dist/components/SubscribeDialog.svelte.d.ts",
      "svelte": "./dist/components/SubscribeDialog.svelte"
    },
    "./SelectionList.svelte": {
      "types": "./dist/components/SelectionList.svelte.d.ts",
      "svelte": "./dist/components/SelectionList.svelte"
    },
    "./SelectionSheet.svelte": {
      "types": "./dist/components/SelectionSheet.svelte.d.ts",
      "svelte": "./dist/components/SelectionSheet.svelte"
    },
    "./BackToTop.svelte": {
      "types": "./dist/components/BackToTop.svelte.d.ts",
      "svelte": "./dist/components/BackToTop.svelte"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.js",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0"
  }
}
